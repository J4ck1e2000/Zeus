+// MiddleClicked reports a click with the middle button, as closing a tab
+// with one.
+func (_handle Element) MiddleClicked() bool {
+	_node := _handle.node()
+	if _node == nil {
+		return false
+	}
+	_ctx := _node.c
+	_ = _ctx
+	_ctx.rt.applyInputs()
+	return _node.MiddleClicked()
+}
