+
+// MiddleClicked reports a click with the middle button, as closing a tab
+// with one.
+func (e *node) MiddleClicked() bool {
+	if !e.hasState() {
 		return false
 	}
+	e.flags |= flagClickable
+	if e.disabled() || e.st.middleClicks == 0 {
+		return false
+	}
 	e.c.rt.consumed = true
 	return true
 }
